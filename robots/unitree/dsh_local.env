# Local MCP task execution. Credentials are loaded from the existing private config.
unitree_dsh_repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
source "$unitree_dsh_repo/robots/unitree/vln_local.env"
export RPENT_TASK_REPORTING=local
export RPENT_CONFIG_FILE="$unitree_dsh_repo/robots/unitree/dsh_local.env"
export RPENT_RUNS_DIR="$unitree_dsh_repo/output/dsh-integration/runs"
export RPENT_MEMORY_DIR="$unitree_dsh_repo/output/dsh-integration/memory"
export RPENT_MCP_URL="${RPENT_MCP_URL:-http://127.0.0.1:8780/mcp/}"
export DSH_HOME="${DSH_HOME:-$unitree_dsh_repo/../dsh-runtime}"
export DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-${OPENAI_API_KEY:-}}"
unset unitree_dsh_repo
