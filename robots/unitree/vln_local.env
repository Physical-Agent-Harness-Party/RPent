# Local Go2 + LightNav configuration; private credentials remain in .env.local.
unitree_vln_repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
source "$unitree_vln_repo/.env.frontend-local"
export RPENT_VENV_DIR="$unitree_vln_repo/../.venv"
export RPENT_NAV_ENDPOINT='http://127.0.0.1:8765'
export RPENT_SIM_ENDPOINT='http://127.0.0.1:8770'
export RPENT_VLN_ENDPOINT='ws://127.0.0.1:8050'
export RPENT_OBSERVATION_ENDPOINT='http://127.0.0.1:8771'
export RPENT_VLN_TIMEOUT_S=120
export RPENT_VLN_INFERENCE_TIMEOUT_S=3
export RPENT_CONFIG_FILE="$unitree_vln_repo/robots/unitree/vln_local.env"
unset unitree_vln_repo
