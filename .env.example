# 复制为 .env.local，填写服务器上的模型配置；已有文件时直接编辑。
# run_rpent.sh 自动加载此文件。使用 Bash 赋值语法，覆盖同名环境变量。

# 在单引号中填写模型 API Key。
export OPENAI_API_KEY=''

# DeepSeek 官方配置，兼容 SDK 的认证变量仍使用 OPENAI_*。
export OPENAI_BASE_URL='https://api.deepseek.com'
export RPENT_MODEL='openai:deepseek-flash'

# 按需取消注释以修改默认值。
# export RPENT_NAV_ENDPOINT='http://192.168.104.191:8765'
# export RPENT_SIM_ENDPOINT='http://192.168.104.191:8770'
# 接收回调的网页后端根地址，不包含 /api/rpend。
export RPENT_FRONTEND_ENDPOINT='http://121.36.57.9:80'
# export RPENT_FRONTEND_SUBTASKS_FORMAT='array'
# export RPENT_NAVIGATION_TIMEOUT_S='300'
# export RPENT_PLANNER_TIMEOUT_S='900'
# export RPENT_MAX_TURNS='16'

# HTTP 启动服务的独立访问令牌，提供给网页后端，与模型 Key 分开设置。
# 非本机监听必须配置。启动 HTTP 服务前 source .env.local。
# export RPENT_RUNNER_TOKEN='替换为随机长字符串'
